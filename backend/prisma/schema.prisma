generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  password                String
  passwordUpdatedAt       DateTime                 @default(now())
  role                    UserRole                 @default(AGENT)
  phone                   String?
  emailVerified           Boolean                  @default(false)
  status                  UserStatus               @default(ACTIVE)
  mustChangePassword      Boolean                  @default(true)
  supervisorId            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  activityActions         ActivityLog[]            @relation("ActivityActor")
  activityUsers           ActivityLog[]            @relation("ActivityTargetUser")
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  createdTickets          Ticket[]                 @relation("TicketCreator")
  updatedTickets          Ticket[]                 @relation("TicketUpdater")
  ticketNotes             TicketNote[]             @relation("TicketNoteCreator")
  supervisor              User?                    @relation("SupervisorToAgent", fields: [supervisorId], references: [id])
  agents                  User[]                   @relation("SupervisorToAgent")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([email])
  @@index([supervisorId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id          String       @id @default(uuid())
  name        String
  email       String?      @unique
  phone       String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tickets     Ticket[]
  ticketNotes TicketNote[] @relation("TicketNoteCustomer")

  @@index([email])
  @@index([phone])
}

model Ticket {
  id               String         @id @default(uuid())
  ticketNumber     String         @unique
  title            String
  description      String
  status           TicketStatus   @default(OPEN)
  priority         Priority       @default(LOW)
  customerId       String
  assignedToId     String?
  createdById      String
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  ticketCategoryId String
  activities       ActivityLog[]
  assignedTo       User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy        User           @relation("TicketCreator", fields: [createdById], references: [id])
  customer         Customer       @relation(fields: [customerId], references: [id])
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  updatedBy        User?          @relation("TicketUpdater", fields: [updatedById], references: [id])
  notes            TicketNote[]

  @@index([ticketNumber])
  @@index([ticketCategoryId])
  @@index([customerId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([updatedById])
}

model ActivityLog {
  id         String             @id @default(uuid())
  action     ActivityLogAction
  entityType ActivityEntityType
  entityId   String
  actorId    String?
  ticketId   String?
  userId     String?
  metadata   Json?
  createdAt  DateTime           @default(now())
  actor      User?              @relation("ActivityActor", fields: [actorId], references: [id])
  ticket     Ticket?            @relation(fields: [ticketId], references: [id])
  user       User?              @relation("ActivityTargetUser", fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([ticketId])
  @@index([userId])
}

model TicketCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([name])
}

model TicketNote {
  id                  String    @id @default(uuid())
  content             String
  isInternal          Boolean   @default(true)
  createdAt           DateTime  @default(now())
  ticketId            String
  createdById         String?
  createdByCustomerId String?
  createdByCustomer   Customer? @relation("TicketNoteCustomer", fields: [createdByCustomerId], references: [id])
  createdBy           User?     @relation("TicketNoteCreator", fields: [createdById], references: [id])
  ticket              Ticket    @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([createdById])
  @@index([createdByCustomerId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserRole {
  AGENT
  SUPERVISOR
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ActivityEntityType {
  TICKET
  USER
  SYSTEM
  CUSTOMER
  TICKET_CATEGORY
}

enum ActivityLogAction {
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_PRIORITY_CHANGED
  TICKET_DELETED
  USER_CREATED
  USER_VERIFICATION_EMAIL_SENT
  USER_EMAIL_VERIFIED
  USER_ASSIGNED_TO_SUPERVISOR
  USER_STATUS_CHANGED
  USER_PASSWORD_RESET
  USER_PASSWORD_RESET_REQUESTED
  USER_PASSWORD_RESET_COMPLETED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_DELETED
  TICKET_CATEGORY_CREATED
  TICKET_CATEGORY_UPDATED
  TICKET_CATEGORY_DELETED
}
